{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/ecommerce-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Cache": {
    "DefaultExpiration": "00:05:00",
    "LocalCacheExpiration": "00:02:00",
    "DistributedCacheExpiration": "00:05:00"
  },
  "Jwt": {
    "Issuer": "ECommerceApi",
    "Audience": "ECommerceClient",
    "ExpirationMinutes": 120
  },
  "GoogleAuth": {
    "ClientId": ""
  },
  "EmailSettings": {
    "ApiKey": "",
    "SenderName": "ECommerce",
    "SenderEmail": ""
  },
  "ClientApp": {
    "BaseUrl": "https://localhost:5001"
  },
  "RateLimiting": {
    "Fixed": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "QueueLimit": 10
    },
    "Auth": {
      "PermitLimit": 5,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Basket": {
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "Outbox": {
    "BatchSize": 20,
    "MaxAttempts": 5,
    "LeaseDurationSeconds": 120,
    "HandlerTimeoutSeconds": 30,
    "BaseDelaySeconds": 5,
    "MaxDelaySeconds": 300
  },
  "Hangfire": {
    "WorkerCount": 4,
    "QueuePollIntervalSeconds": 15,
    "SlidingInvisibilityTimeoutMinutes": 5,
    "CommandBatchMaxTimeoutMinutes": 5,
    "ServerTimeoutSeconds": 60
  }
}
