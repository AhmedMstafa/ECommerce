# Copy this file to .env in the repository root and replace every placeholder.
# .env is gitignored. Never commit real values.

# Required: JWT signing secret. Generate a long random value (at least 32 bytes).
Jwt__SecretKey=replace-with-a-long-random-secret

# Required: SQL Server connection string used by EF Core, Identity, Hangfire
# and the readiness health check.
ConnectionStrings__DefaultConnection=Server=localhost;Database=ECommerceDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true

# Required: Upstash Redis connection string. Copy the "rediss://" URL from the
# Upstash console. TLS is enforced by the rediss:// scheme. Never commit it.
# A placeholder value makes startup fail fast with a clear message.
Redis__Configuration=replace-with-upstash-rediss-connection-string

# Optional: Redis key prefix (defaults to ECommerce:).
Redis__InstanceName=ECommerce:

# Optional: Google Sign-In. Only a Web Client ID is needed; no client secret.
GoogleAuth__ClientId=replace-with-google-web-client-id

# Optional: Resend API for password-reset emails.
# Use an API key with sending access and a verified sending domain.
EmailSettings__ApiKey=replace-with-resend-api-key
EmailSettings__SenderName=ECommerce Support
EmailSettings__SenderEmail=onboarding@resend.dev

# Base URL used to build the password-reset link.
ClientApp__BaseUrl=http://localhost:5001

# Required for Stripe payment integration (use test-mode keys locally).
Stripe__SecretKey=replace-with-stripe-secret-key
Stripe__PublishableKey=replace-with-stripe-publishable-key
Stripe__WebhookSecret=replace-with-stripe-webhook-secret

# Optional: Shopping basket (Redis). Baskets are temporary state; SQL remains
# the source of truth for products, prices and stock.
Basket__AnonymousExpirationDays=7
Basket__AuthenticatedExpirationDays=30
Basket__MaximumLifetimeDays=60
Basket__MaximumItems=50
Basket__MaximumQuantityPerProduct=20

# Optional: Swagger UI (enabled by default in Development and Production).
# Set false to disable the public Swagger UI.
Swagger__Enabled=true

# Optional: Development-only admin seeding.
SeedAdmin__Email=admin@example.com
SeedAdmin__Password=replace-with-a-strong-password
