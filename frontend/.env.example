# Copy to frontend/.env. Vite embeds VITE_* values into the browser bundle,
# so only public values belong here. Never put sk_*, whsec_*, JWT secrets or
# connection strings in this file.

# Local API. On Vercel use the HTTPS Railway URL of the API.
VITE_API_BASE_URL=http://localhost:5246

# Stripe publishable key only (pk_test_... / pk_live_...).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
